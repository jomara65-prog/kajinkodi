{
  "name": "kajinkodi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "dev:api": "npm --workspace apps/api run dev",
    "dev:quest": "npm --workspace @kajinkodi/quest-engine run dev",
    "dev:iot": "npm --workspace @kajinkodi/iot-ingest run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
